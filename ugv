#!/bin/bash

if [ ! -f .version ]; then
    echo "Error: .version file not found, not a ugv managed project"
    exit 1
fi

if [ $# -eq 1 ]; then

    if [ -e .git ]; then
        echo git is detected.
        GIT_EXIST=1
    else
        echo git is not detected.
        GIT_EXIST=0
    fi

    echo -n $1 > /tmp/.new_version
    OLD_VER=$(cat .version)
    VER_DATE=$(date +%Y%m%d)

    if [ $GIT_EXIST -eq 1 ]; then
        git tag "v${OLD_VER}_${VER_DATE}"
        git branch "v${OLD_VER}"
    fi

    files=$(fd -t f -e xml pom.xml | wc -l)
    if [ $files -gt 0 ]; then
        fd -t f -e xml pom.xml -X sed "s/<version>$OLD_VER<\/version> *<!-- managed by updgitver -->$/<version>$1<\/version><!-- managed by updgitver -->/g" -i {}
    fi
    files=$(fd -t f -e gradle build.gradle | wc -l)
    if [ $files -gt 0 ]; then
        fd -t f -e gradle build.gradle -X sed "s/'$OLD_VER' *\/\/ managed by updgitver$/'$1' \/\/ managed by updgitver/g" -i {}
    fi
    files=$(fd -t f -e toml Cargo.toml | wc -l)
    if [ $files -gt 0 ]; then
        fd -t f -e toml Cargo.toml -X sed "s/\"$OLD_VER\" *# managed by updgitver$/\"$1\" # managed by updgitver/g" -i {}
    fi
    files=$(fd -t f -e toml -E lib pyproject.toml | wc -l)
    if [ $files -gt 0 ]; then
        fd -t f -e toml -E lib pyproject.toml -X sed "s/\"$OLD_VER\" *# managed by updgitver$/\"$1\" # managed by updgitver/g" -i {}
    fi
    files=$(fd -t f -e py -E lib setup.py | wc -l)
    if [ $files -gt 0 ]; then
        fd -t f -e py -E lib setup.py -X sed "s/\"$OLD_VER\", *# managed by updgitver$/\"$1\", # managed by updgitver/g" -i {}
    fi
    files=$(fd -t f -e json -E node_modules package.json | wc -l)
    if [ $files -gt 0 ]; then
        while IFS= read -r pkg; do
            awk -v old="$OLD_VER" -v new="$1" 'NR==3 && /"version"/ { sub(old, new) } 1' "$pkg" > "$pkg.tmp" \
                && mv "$pkg.tmp" "$pkg"
        done < <(fd -t f -e json -E node_modules package.json)
    fi

    mv /tmp/.new_version .version

    if [ $GIT_EXIST -eq 1 ]; then
        git commit -a -m "build: change to new version: $1"
    fi
else
  echo "usage: ugv x.y.z"
fi

